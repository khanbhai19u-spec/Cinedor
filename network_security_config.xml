<?xml version="1.0" encoding="utf-8"?>
<!-- Lets the app talk to your home server over plain http (same Wi-Fi).
     When your server is online with https, remove cleartextTrafficPermitted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
